# Copy to .env (same folder). Never commit .env.
OPENAI_API_KEY=sk-...
# Password for the tutor admin page (/admin). Required to see AI usage.
ADMIN_PASSWORD=change-me

# Optional
# OPENAI_MODEL=gpt-4.1-mini
# AI_MAX_OUTPUT_TOKENS=900
# AI_DAILY_LIMIT_PER_STUDENT=60          # per student per 24h, 0 = unlimited
# OPENAI_PRICE_INPUT_PER_1M=0.40         # only for the admin page's cost estimate (USD)
# OPENAI_PRICE_OUTPUT_PER_1M=1.60
# CORS_ORIGINS=http://localhost:3000
SEED_ACCOUNTS=stu,test
